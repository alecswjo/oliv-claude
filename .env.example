# Oliv backend configuration.
# Copy to `.env`. When these are UNSET, the app runs fully local/offline
# (AsyncStorage + on-device, seeded demo social) exactly as before — every
# backend feature is gated on these being present.

# From Supabase dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# ---- Server-only secrets (NOT prefixed EXPO_PUBLIC; set via `supabase secrets set`) ----
# These live on the Edge Function, never in the app bundle:
#   ANALYZE_PROVIDER=openai         (openai | anthropic | gemini)
#   CHAT_PROVIDER=openai            (openai | anthropic | google)
#   CHAT_MODEL=                      (optional per-provider override)
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-5.5
#   ANTHROPIC_API_KEY=sk-ant-...
#   ANTHROPIC_MODEL=claude-opus-4-8
#   GOOGLE_API_KEY=...
#   GOOGLE_MODEL=gemini-2.5-flash

# The texting agent's phone number (shown in Settings; from your Sendblue line)
EXPO_PUBLIC_OLIV_AGENT_NUMBER=

# RevenueCat public SDK keys (safe to embed in the app). The entitlement ID
# and current offering must match the RevenueCat dashboard.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# Edge Function secrets (set with `supabase secrets set`, never in an Expo
# build): REVENUECAT_WEBHOOK_AUTH, REVENUECAT_ENTITLEMENT_ID=pro. Enable
# REQUIRE_ACTIVE_SUBSCRIPTION=true only after the webhook is verified.

# Texting edge-function secrets (server-only):
#   SENDBLUE_WEBHOOK_SECRET=...    (configured on the Sendblue webhook)
#   AGENT_SECRET=...               (different secret; gateway → agent-analyze)
